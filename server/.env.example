PORT=4000
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# Google Sign-In: OAuth 2.0 Client ID from Google Cloud Console
# (Credentials > Create Credentials > OAuth client ID > Web application).
# Must match VITE_GOOGLE_CLIENT_ID in client/.env.
GOOGLE_CLIENT_ID=

# Leave DATABASE_URL unset for local dev (uses a SQLite file automatically).
# In production (Render), this is set for you when you attach a Postgres database.
# DATABASE_URL=postgres://user:password@host:5432/dbname
